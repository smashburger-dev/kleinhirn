{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "@webgpu/types"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "bench/**/*.ts",
    "site/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "vite.config.ts",
    "vite.site.config.ts"
  ],
  "exclude": [
    "src/wasm"
  ]
}